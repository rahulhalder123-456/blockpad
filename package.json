{
  "name": "blockpad",
  "version": "1.8.1",
  "description": "Blockpad - a local-first block editor, wiki and database workspace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "node tools/build-web.js",
    "package": "node tools/build.js win32-x64",
    "package:linux": "node tools/build.js linux-x64",
    "package:mac-arm64": "node tools/build.js darwin-arm64",
    "package:mac-x64": "node tools/build.js darwin-x64",
    "installer": "electron-builder --prepackaged build/v1.8.1/Blockpad-win32-x64 --win nsis",
    "android": "node tools/build-web.js && cap sync android",
    "icons": "node tools/make-icon.js && node tools/make-pwa-icons.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1"
  },
  "dependencies": {
    "hyperdht": "^6.34.1",
    "hyperswarm": "^4.17.2",
    "tweetnacl": "^1.0.3"
  },
  "build": {
    "appId": "app.blockpad.desktop",
    "productName": "Blockpad",
    "artifactName": "Blockpad-Setup.exe",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blockpad",
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Blockpad share link",
        "schemes": [
          "blockpad"
        ]
      }
    ],
    "directories": {
      "output": "installer"
    }
  }
}